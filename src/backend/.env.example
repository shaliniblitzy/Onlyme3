# =============================================================================
# Example .env file for Node.js/Express.js Tutorial Application
# =============================================================================
# Copy this file to .env and adjust values as needed for your local environment.
# This file is safe to commit to version control as it contains no sensitive data.
# 
# For production deployments, create a separate .env file with production-specific
# values and ensure it's added to your .gitignore file.
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# The port number the Express server will listen on
# Default: 3000 (standard development port)
# Valid range: 1024-65535 (ports below 1024 require admin privileges)
PORT=3000

# The host address to bind the server to
# Default: 127.0.0.1 (localhost - local development only)
# Use 0.0.0.0 to bind to all network interfaces (production)
HOST=127.0.0.1

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Logging verbosity level - controls how much information is logged
# Available levels: error, warn, info, debug
# - error: Only log errors and critical issues
# - warn: Log warnings and errors
# - info: Log informational messages, warnings, and errors (recommended for development)
# - debug: Log all messages including debug information (verbose)
LOG_LEVEL=info

# =============================================================================
# NODE.JS ENVIRONMENT CONFIGURATION
# =============================================================================
# Node.js environment mode - affects Express.js behavior and optimizations
# Available environments:
# - development: Enables detailed error messages, auto-restart, and debug features
# - production: Enables performance optimizations, caching, and error handling
# - test: Used for running automated tests with test-specific configurations
NODE_ENV=development

# =============================================================================
# EDUCATIONAL NOTES
# =============================================================================
# This tutorial application demonstrates:
# - Environment variable configuration best practices
# - Express.js 5.1.0 server configuration
# - Node.js 22.x LTS runtime environment setup
# - Local development environment standards
# - Security-conscious development practices
#
# The application serves a simple "Hello world" response at the /hello endpoint,
# providing a foundation for learning Node.js and Express.js fundamentals.
# =============================================================================

# =============================================================================
# USAGE INSTRUCTIONS
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit the .env file to match your local development setup
# 3. Restart your application to apply the new environment variables
# 4. The application will use these values or fall back to sensible defaults
# =============================================================================

# =============================================================================
# TROUBLESHOOTING
# =============================================================================
# If you encounter issues:
# - Ensure the PORT is not already in use by another application
# - Verify HOST address is valid and accessible
# - Check that LOG_LEVEL is one of: error, warn, info, debug
# - Confirm NODE_ENV is one of: development, production, test
# - Restart your application after making changes
# =============================================================================