# =============================================================================
# .gitignore - Git Repository Ignore Rules
# =============================================================================
# This file specifies intentionally untracked files that Git should ignore.
# It ensures clean repository hygiene, security, and cross-platform compatibility
# for the Node.js tutorial application and its development environment.
#
# Organization:
# - Node.js and npm specific patterns
# - Build and distribution artifacts
# - Environment and configuration files
# - Development tools and logs
# - Operating system specific files
# - Editor and IDE configurations
# - Testing and coverage reports
# - Backend-specific patterns (src/backend/)
# - Frontend-specific patterns (src/frontend/)
# =============================================================================

# =============================================================================
# Node.js Dependencies and Package Management
# =============================================================================
# Node.js dependencies installed via npm, yarn, or pnpm
# These should be installed locally via package managers and not committed
node_modules/

# Dependency lock files (auto-generated, not always ignored, but often for local dev)
# These files ensure deterministic builds but may be excluded in tutorial environments
# to allow flexibility in dependency versions during learning
package-lock.json
yarn.lock
pnpm-lock.yaml

# =============================================================================
# Build Output and Distribution Files
# =============================================================================
# Compiled JavaScript, bundled assets, and build artifacts
# These are generated during the build process and should not be version controlled
dist/
build/

# =============================================================================
# Environment Variables and Configuration
# =============================================================================
# Environment configuration files containing sensitive information
# These files may contain API keys, database passwords, and other secrets
# that should never be committed to version control
.env
.env.*

# =============================================================================
# Logs and Debug Output
# =============================================================================
# Log files generated by npm, yarn, pnpm, and the application
# These files contain runtime information and debugging data
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# =============================================================================
# Operating System Specific Files
# =============================================================================
# Files created by different operating systems that are not part of the project
# These files ensure cross-platform compatibility as specified in requirements

# macOS specific files
.DS_Store

# Windows specific files
Thumbs.db

# =============================================================================
# Editor and IDE Configuration Files
# =============================================================================
# Configuration files for various editors and IDEs
# These contain personal preferences and should not be shared across team members

# Visual Studio Code
.vscode/

# JetBrains IDEs (IntelliJ IDEA, WebStorm, etc.)
.idea/

# Sublime Text
*.sublime-workspace
*.sublime-project

# =============================================================================
# Test Coverage Output
# =============================================================================
# Test coverage reports and related files
# These are generated during testing and should not be committed
coverage/

# =============================================================================
# Miscellaneous Development Files
# =============================================================================
# Temporary files, swap files, and other development artifacts
*.local
*.swp
*.swo

# =============================================================================
# Docker and Container Configuration
# =============================================================================
# Docker override files that may contain local development configurations
docker-compose.override.yml

# =============================================================================
# Backend Specific Patterns (src/backend/)
# =============================================================================
# Files specific to the backend portion of the application
# These patterns ensure backend-specific artifacts are not committed

# Backend environment variables
src/backend/.env
src/backend/.env.*

# Backend dependencies (if backend has separate package.json)
src/backend/node_modules/

# Backend build output
src/backend/dist/

# Backend test coverage
src/backend/coverage/

# =============================================================================
# Frontend Specific Patterns (src/frontend/)
# =============================================================================
# Files specific to the frontend portion of the application
# These patterns handle frontend build artifacts and configurations

# Frontend environment variables
src/frontend/.env
src/frontend/.env.*

# Frontend dependencies (if frontend has separate package.json)
src/frontend/node_modules/

# Frontend build output
src/frontend/dist/
src/frontend/build/

# Frontend test coverage
src/frontend/coverage/

# =============================================================================
# Security and Sensitive Data Protection
# =============================================================================
# This section implements security considerations as per Technical Specifications
# Section 3.6.6 - Security Considerations
#
# The patterns above collectively ensure that:
# - Sensitive environment variables are never committed (.env files)
# - Dependencies are managed through package managers, not version control
# - Build artifacts are generated locally and not shared
# - Personal development configurations remain private
# - Operating system specific files don't pollute the repository
#
# This supports the Node.js tutorial application's security requirements
# while maintaining cross-platform compatibility and clean repository hygiene.
# =============================================================================